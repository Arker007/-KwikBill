{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@free-gst/document-renderer": [
        "packages/document-renderer/src/index.ts"
      ],
      "@free-gst/document-renderer/*": [
        "packages/document-renderer/src/*"
      ],
      "@free-gst/financial-core": [
        "packages/financial-core/src/index.ts"
      ],
      "@free-gst/financial-core/*": [
        "packages/financial-core/src/*"
      ],
      "@free-gst/api-contracts": [
        "packages/api-contracts/src/index.ts"
      ],
      "@free-gst/api-contracts/*": [
        "packages/api-contracts/src/*"
      ],
      "@free-gst/ui": [
        "packages/ui/src/index.ts"
      ],
      "@free-gst/ui/*": [
        "packages/ui/src/*"
      ],
      "@free-gst/api-client": [
        "packages/api-client/src/index.ts"
      ],
      "@free-gst/api-client/*": [
        "packages/api-client/src/*"
      ],
      "@free-gst/api": [
        "apps/api/src/bootstrap/index.ts"
      ],
      "@free-gst/api/*": [
        "apps/api/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "data"
  ]
}
